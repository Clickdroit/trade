# Copier en .env. Ne jamais commiter .env ni partager les cles API.
# Aucune cle n'est necessaire : le backtest et le Paper Trading n'utilisent que
# des donnees publiques. Ne JAMAIS renseigner de cle de compte Binance reel.
BINANCE_API_KEY=
BINANCE_API_SECRET=

TRADING_SYMBOL=BTC/USDT
TRADING_TIMEFRAME=1h
SHORT_MA=10
LONG_MA=30

# Parametres de simulation (backtest et Paper Trading)
STARTING_BALANCE=1000
STOP_LOSS_PCT=0.03
FEE_RATE=0.001
SLIPPAGE_PCT=0.0005

# Risque
MAX_POSITION_FRACTION=0.10
MAX_DAILY_LOSS_FRACTION=0.05
# false : la limite journaliere bloque les entrees sans fermer la position.
CLOSE_POSITION_ON_DAILY_LOSS=false

# Paper Trading
PAPER_DB_PATH=data/paper_state.sqlite3
POLL_SECONDS=60
CATCHUP_MAX_CANDLES=200

# Source de marche (lecture publique uniquement)
REQUEST_TIMEOUT_MS=10000
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# Securite : ne jamais passer DRY_RUN a false ni EXECUTION_MODE a autre chose que paper.
DRY_RUN=true
EXECUTION_MODE=paper
LOG_LEVEL=INFO
