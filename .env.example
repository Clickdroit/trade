# Copier en .env. Ne jamais commiter .env ni partager les clés API.
# Le backtest et la lecture de marché n'utilisent que des données publiques.
BINANCE_API_KEY=
BINANCE_API_SECRET=

TRADING_SYMBOL=BTC/USDT
TRADING_TIMEFRAME=1h
SHORT_MA=10
LONG_MA=30

# Paramètres de simulation (identiques pour le backtest)
STARTING_BALANCE=1000
STOP_LOSS_PCT=0.03
FEE_RATE=0.001
SLIPPAGE_PCT=0.0005

DRY_RUN=true
LOG_LEVEL=INFO
